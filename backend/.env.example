# Environment variables for IoT Backend

# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.py
FLASK_DEBUG=False

# Security
SECRET_KEY=change-this-to-a-secure-secret-key

# Server Configuration
HOST=0.0.0.0
PORT=5001

# Database (if you add one in the future)
# DATABASE_URL=postgresql://user:password@localhost:5432/iot_db

# CORS (if you need specific origins)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Logging
LOG_LEVEL=INFO

# MongoDB Configuration
MONGODB_URI=mongodb://admin:password123@mongodb:27017/iot_db?authSource=admin
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=iot_db
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password123